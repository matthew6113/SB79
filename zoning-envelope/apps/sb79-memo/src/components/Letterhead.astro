---
import { memoConfig } from '../memo.config';
import { B, asOf } from '../memo-data';
import { date } from '../format';

// DATE is the data snapshot's as-of date (data/manifest.json).
const dated = date(asOf);
---

<header class="letterhead">
  <p class="letterhead-title">Memorandum</p>
  <dl>
    <dt>To</dt><dd>{memoConfig.to}</dd>
    <dt>From</dt><dd>{memoConfig.from}</dd>
    <dt>Date</dt><dd>{dated}</dd>
    <dt>Re</dt><dd>What SB 79 allows at {B.address}, North Berkeley</dd>
  </dl>
  <p class="disclaimer">For general information only. Not legal advice. Facts and law as of {dated}.</p>
  <p class="disclaimer disclaimer-ai">AI was used to research and draft this memo and to build its figures and calculator, and it may make mistakes. Check every point against the cited statute and sources.</p>
</header>
